---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Social share image, as a path under /public (e.g. '/og-image.jpg'). */
  image?: string;
}

const {
  title = 'Slovenia Games Conference',
  description = 'Slovenia Games Conference — the annual conference on game development, design, marketing, and business in Slovenia.',
  image = '/og-image.jpg',
} = Astro.props;

// Absolute URLs are required for Open Graph / Twitter previews.
const siteOrigin = Astro.site ?? new URL('https://sgc.si');
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const imageUrl = new URL(image, siteOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c4502f" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph (Facebook, LinkedIn, Discord, …) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Slovenia Games Conference" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Slovenia Games Conference 2027" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/sgcFavicon.png" />
    <link rel="apple-touch-icon" href="/sgcFavicon.png" />
    <link
      rel="preload"
      href="/fonts/FunnelSans-VariableFont_wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      // Deep-links to in-page anchors (e.g. /#indies) can land in the wrong
      // spot in production: the browser jumps before images/fonts above the
      // target finish loading, which then shift the layout. Re-scroll to the
      // hash once everything has loaded so the target respects its
      // scroll-margin-top and lands correctly.
      (() => {
        const scrollToHash = () => {
          if (!location.hash || location.hash.length < 2) return;
          let el;
          try {
            el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
          } catch (_) {
            el = document.getElementById(location.hash.slice(1));
          }
          if (el) el.scrollIntoView();
        };
        const run = () => {
          requestAnimationFrame(scrollToHash);
          // Catch late layout shifts from web fonts / lazy images.
          setTimeout(scrollToHash, 300);
        };
        if (document.readyState === 'complete') run();
        else window.addEventListener('load', run, { once: true });
      })();
    </script>
  </body>
</html>
