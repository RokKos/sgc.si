---
// Per-logo heights are tuned so the logos read as optically similar in size
// despite different proportions (wide wordmarks vs tall illustration).
const partners = [
  { name: 'Slovenia Games Association', logo: '/PartnerLogos/partner-1.webp', h: 72 },
  { name: 'Reload Akademija', logo: '/PartnerLogos/partner-2.png', url: 'https://reloadakademija.si', h: 66 },
  { name: 'Game Dev Days', logo: '/PartnerLogos/partner-gamedevdays.png', url: 'https://gamedevdays.com/', h: 140 },
  { name: 'Zagreb Games Week', logo: '/PartnerLogos/partner-3.png', url: 'https://zagrebgamesweek.com/en', h: 104 },
];
---

<section class="partners" id="partners" aria-labelledby="partners-title">
  <div class="container partners-wrap">
    <h2 id="partners-title">Partners</h2>
    <div class="partners-grid">
      {partners.map((partner) => {
        const Tag = partner.url ? 'a' : 'div';
        const linkProps = partner.url
          ? { href: partner.url, target: '_blank', rel: 'noopener noreferrer', 'aria-label': partner.name }
          : {};
        return (
          <Tag class={`partner-tile${partner.url ? ' is-link' : ''}`} {...linkProps}>
            <img
              src={partner.logo}
              alt={partner.name}
              class="partner-logo"
              style={`height:${partner.h}px`}
            />
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<style>
.partners {
  background: #1c2a3c;
  color: #ffffff;
  padding: 4.4rem 0 5rem;
}

.partners-wrap { width: min(1120px, 92%); text-align: left; }

.partners h2 {
  margin: 0 0 3rem;
  color: #ffffff;
  font-size: clamp(2.4rem, 5vw, 4rem);
  line-height: 1;
  letter-spacing: -0.02em;
  font-weight: 700;
}

.partners-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: center;
  gap: 2rem;
}

.partner-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160px;
}

.partner-tile.is-link {
  text-decoration: none;
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.partner-tile.is-link:hover {
  opacity: 0.82;
  transform: translateY(-2px);
}

.partner-logo {
  width: auto;
  max-width: 100%;
  object-fit: contain;
}

@media (max-width: 860px) {
  .partners-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem; }
}

@media (max-width: 440px) {
  .partners-grid { grid-template-columns: 1fr; }
}
</style>
