---
// Frequently asked questions. The design groups the general / attendee
// questions in the left column and the venue + indie questions in the right
// column, so the two columns are rendered explicitly rather than auto-flowed.
// Answers stay click-to-open accordions.
const faqsLeft = [
  {
    q: 'When and where is Slovenia Games Conference 2027?',
    a: 'Saturday, 20 February 2027 at the Faculty of Computer and Information Science (FRI) in Ljubljana, Slovenia.',
  },
  {
    q: 'What are the conference opening hours?',
    a: 'The conference schedule and exact opening hours will be announced closer to the event.',
  },
  {
    q: 'Who is the conference for?',
    a: 'SGC is open to anyone interested in the games industry, including developers, artists, designers, students, publishers, business professionals, and gaming enthusiasts.',
  },
  {
    q: 'Are there student discounts?',
    a: 'Yes! Students can purchase discounted tickets for 20€. You may be asked to provide valid student identification at the event.',
  },
  {
    q: 'Will food and drinks be available?',
    a: 'Lunch and a coffee break are included with every ticket. Lunch includes meat and vegan options.',
  },
  {
    q: 'Is there parking available at the venue?',
    a: 'The FRI parking garage is not open to the general public. However, there is a free public parking lot nearby. Indie exhibitors receive one reserved free parking spot per team in the FRI parking garage.',
  },
];

const faqsRight = [
  {
    q: 'How can I get to the venue?',
    a: 'You can reach FRI by public transport, car, bicycle or car-sharing.\nPublic transport: Take bus line 18 and get off at the Živalski vrt – ZOO stop. From there, it’s about a 5-minute walk to the faculty.\nBicycle: BicikeLJ bike-sharing stations are available nearby.\nCar sharing: Avant2Go vehicles and parking spots are also available in the area.',
  },
  {
    q: 'Can I showcase my indie game?',
    a: 'Yes! Independent developers and studios can apply to showcase their games. We welcome playable projects at all stages of development, from early prototypes to released games. Fill out the Indie Showcase registration form on our website before 20 January 2027. The organisers will review submissions and contact applicants by email.',
  },
  {
    q: 'What does an indie exhibitor get?',
    a: 'Each exhibitor receives an exhibition desk with two chairs, electricity and Wi-Fi, one free parking spot per team, and promotion through SGC’s website and social media channels. Laptop and monitor rentals can also be requested in advance, subject to availability.',
  },
  {
    q: 'Are discounted tickets available for indie exhibitors?',
    a: 'Yes. Each exhibitor can receive up to two reduced-price tickets for non-student attendees at 30€ each. Additional non-student attendees must purchase regular tickets. Students are eligible for the 20€ student ticket.',
  },
];
---

<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq-wrap">
    <h2 id="faq-title">Frequently Asked Questions</h2>
    <div class="faq-grid">
      <div class="faq-col">
        {faqsLeft.map((item) => (
          <details class="faq-item">
            <summary class="faq-q">
              <span class="faq-q-text">{item.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))}
      </div>
      <div class="faq-col">
        {faqsRight.map((item) => (
          <details class="faq-item">
            <summary class="faq-q">
              <span class="faq-q-text">{item.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.faq {
  background: #f7f6f4;
  color: #1f2529;
  padding: clamp(3.2rem, 6vw, 5rem) 0;
  scroll-margin-top: 7rem;
}

.faq-wrap { width: min(1120px, 92%); }

.faq h2 {
  margin: 0 0 2.6rem;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1;
  letter-spacing: -0.02em;
  font-weight: 700;
  color: #16202b;
}

.faq-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 3rem;
  align-items: start;
}

.faq-col { display: flex; flex-direction: column; }

.faq-item {
  border-top: 1px solid #ddd6cb;
}

.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin: 0;
  padding: 1.05rem 0;
  cursor: pointer;
  list-style: none;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
  font-size: 1.12rem;
  font-weight: 700;
  color: #16202b;
  line-height: 1.3;
  transition: color 0.15s ease;
}

.faq-q::-webkit-details-marker { display: none; }

.faq-q:hover { color: #ff4d10; }

.faq-q:focus-visible {
  outline: 2px solid #ff4d10;
  outline-offset: 3px;
}

/* Chevron indicator — points down when closed, flips up when open. */
.faq-icon {
  flex: none;
  width: 9px;
  height: 9px;
  margin-right: 0.3rem;
  border-right: 2px solid #8a8f96;
  border-bottom: 2px solid #8a8f96;
  transform: translateY(-2px) rotate(45deg);
  transition: transform 0.2s ease, border-color 0.15s ease;
}

.faq-q:hover .faq-icon { border-color: #ff4d10; }

.faq-item[open] .faq-icon {
  transform: translateY(2px) rotate(-135deg);
}

.faq-a {
  margin: 0;
  padding: 0 1.8rem 1.15rem 0;
  color: #4d555d;
  font-size: 1rem;
  line-height: 1.55;
  /* Preserve the line breaks in multi-line answers (e.g. directions). */
  white-space: pre-line;
}

@media (max-width: 760px) {
  .faq-grid { grid-template-columns: 1fr; gap: 0; }
}
</style>
