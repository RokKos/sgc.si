---
// The Venue — full-bleed split: navy info panel on the left, the FRI building
// photo on the right. Matches the venue layout in the design.
---

<section class="venue-section" id="venue" aria-labelledby="venue-title">
  <div class="venue-split">
    <div class="venue-info">
      <h2 id="venue-title" class="venue-feature-title">The Venue</h2>
      <div class="venue-details">
        <h3>Faculty of Computer and<br />Information Science</h3>
        <p class="venue-addr"><strong>Večna pot 113</strong><br />1000 Ljubljana, Slovenia</p>
        <p class="venue-date">Saturday, 20 February 2027</p>
        <a class="venue-directions" href="/getting-here">Directions →</a>
      </div>
    </div>
    <div class="venue-photo">
      <img src="/fri-venue.jpg" alt="Faculty of Computer and Information Science building" />
    </div>
  </div>
</section>

<style>
/* Full-bleed split across the whole viewport width. */
.venue-section { background: #12233b; }

.venue-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: stretch;
}

/* Left padding aligns the copy with the site's content column on wide screens. */
.venue-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #12233b;
  padding: clamp(3rem, 6vw, 5.5rem) clamp(1.75rem, 4vw, 3.5rem);
  padding-left: max(1.75rem, calc((100vw - 1120px) / 2));
}

.venue-feature-title {
  margin: 0 0 clamp(2.2rem, 5vw, 4rem);
  font-size: clamp(2.2rem, 4.4vw, 3.4rem);
  line-height: 0.98;
  letter-spacing: -0.02em;
  color: #ffffff;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
  font-weight: 700;
}

.venue-details h3 {
  margin: 0;
  font-size: clamp(1.45rem, 2.6vw, 2.1rem);
  line-height: 1.1;
  color: #ffffff;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
  font-weight: 700;
}

.venue-addr { margin: 1rem 0 0; color: rgba(255, 255, 255, 0.72); line-height: 1.55; font-size: 1.08rem; }
.venue-addr strong { color: #ffffff; font-weight: 700; }

.venue-date {
  margin: 1.6rem 0 0;
  color: #ff4d10;
  font-weight: 700;
  font-size: clamp(1.2rem, 2vw, 1.55rem);
  letter-spacing: -0.01em;
}

.venue-directions {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  margin-top: 1.8rem;
  padding: 0.85rem 1.8rem;
  background: #ff4d10;
  color: #fff;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
}
.venue-directions:hover { background: #ffffff; color: #ff4d10; box-shadow: inset 0 0 0 2px #ff4d10; transform: translateY(-1px); }

.venue-photo { position: relative; min-height: 440px; }
.venue-photo img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

@media (max-width: 860px) {
  .venue-split { grid-template-columns: 1fr; }
  .venue-info { padding-left: clamp(1.75rem, 6vw, 3.5rem); }
  .venue-photo { min-height: 300px; }
}
</style>
