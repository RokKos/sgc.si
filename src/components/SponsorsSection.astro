---
import { sponsors } from '../data/sponsors';

// Tiered logo wall on dark navy: the main sponsor largest, then a middle tier,
// then the remaining tier — matching the sponsors layout in the design.
const main = sponsors.find((s) => s.tier === 'General') ?? sponsors[0];
const tier2 = sponsors.filter((s) => s.tier === 'Venue' || s.tier === 'Platinum');
const tier3 = sponsors.filter((s) => s.tier === 'Gold' || s.tier === 'Silver' || s.tier === 'Bronze');

// On the dark background use the white/light logo variants where available.
const whiteLogos: Record<string, string> = {
  'Guardiaris': '/SponsorLogos/guardiarisWhiteLogo.png',
  'UL FRI — Faculty of Computer and Information Science': '/SponsorLogos/UL_FRI_logoHOR-RGB_bela.png',
  'Triternion': '/SponsorLogos/triternion-logo-white.png',
  'Outfit7': '/SponsorLogos/Outfit7-Logo.png',
  'Razum': '/SponsorLogos/Razum-logo.png',
  'Bubadu': '/SponsorLogos/Bubadu-logo-white.png',
};
const logoFor = (s: (typeof sponsors)[number]) => whiteLogos[s.name] ?? s.logo;
---

<section class="home-sponsors" id="sponsors" aria-labelledby="home-sponsors-title">
  <div class="container hs-wrap">
    <h2 id="home-sponsors-title">Sponsors</h2>

    {main && (
      <div class="hs-tier hs-tier-main">
        <img src={logoFor(main)} alt={main.name} class="hs-logo" />
      </div>
    )}

    {tier2.length > 0 && (
      <div class="hs-tier hs-tier-2">
        {tier2.map((s) => (
          <img src={logoFor(s)} alt={s.name} class="hs-logo" />
        ))}
      </div>
    )}

    {tier3.length > 0 && (
      <div class="hs-tier hs-tier-3">
        {tier3.map((s) => (
          <img src={logoFor(s)} alt={s.name} class="hs-logo" />
        ))}
      </div>
    )}

    <p class="hs-link-row">
      Want to become a sponsor?
      <a href="mailto:info@sgc.si?subject=Sponsoring%20Slovenia%20Games%20Conference%202027" class="hs-link">Contact us.</a>
    </p>
  </div>
</section>

<style>
.home-sponsors {
  background: #12233b;
  color: #eef3f6;
  padding: 4.2rem 0 4.8rem;
}

.hs-wrap { width: min(1120px, 92%); }

.home-sponsors h2 {
  margin: 0 0 3rem;
  text-align: left;
  color: #ffffff;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1;
  letter-spacing: -0.02em;
  font-weight: 700;
}

/* Each tier is its own centered row; logos are capped by height so the
   different proportions read at a consistent optical size within a tier. */
.hs-tier {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.hs-logo {
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
}

/* Tier 1 — main sponsor, largest. */
.hs-tier-main { margin-bottom: clamp(2.4rem, 4vw, 3.4rem); }
.hs-tier-main .hs-logo {
  max-height: clamp(5rem, 8.5vw, 7.5rem);
  max-width: min(520px, 80%);
}

/* Tier 2 — two across, medium. */
.hs-tier-2 {
  gap: clamp(2.5rem, 7vw, 6rem);
  margin-bottom: clamp(2.4rem, 4vw, 3.4rem);
}
.hs-tier-2 .hs-logo {
  max-height: clamp(3.2rem, 5vw, 4.5rem);
  max-width: 280px;
}

/* Tier 3 — three across, smaller. */
.hs-tier-3 {
  gap: clamp(2.2rem, 6vw, 5rem);
}
.hs-tier-3 .hs-logo {
  max-height: clamp(2.5rem, 3.8vw, 3.5rem);
  max-width: 200px;
}

.hs-link-row {
  margin: clamp(2.6rem, 5vw, 3.6rem) 0 0;
  text-align: center;
  color: #ffffff;
  font-weight: 600;
  font-size: 1.05rem;
}

.hs-link {
  color: #ff4d10;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
}

.hs-link:hover {
  color: #ff7a4d;
  text-decoration: underline;
}

@media (max-width: 560px) {
  .hs-tier-2 { gap: 2rem 3rem; }
  .hs-tier-3 { gap: 1.6rem 2.4rem; }
}
</style>
