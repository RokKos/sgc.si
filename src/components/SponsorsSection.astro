---
import { sponsors } from '../data/sponsors';

// Main sponsor shown large; the rest form a logo wall below.
const main = sponsors.find((s) => s.tier === 'General') ?? sponsors[0];
const rest = sponsors.filter((s) => s !== main);

// This section sits on a dark navy background, so use the white/light logo
// variants where available (falling back to each sponsor's default logo).
const whiteLogos: Record<string, string> = {
  'Guardiaris': '/SponsorLogos/guardiarisWhiteLogo.png',
  'UL FRI — Faculty of Computer and Information Science': '/SponsorLogos/UL_FRI_logoHOR-RGB_bela.png',
  'Triternion': '/SponsorLogos/triternion-logo-white.png',
  'Outfit7': '/SponsorLogos/Outfit7-Logo.png',
  'Razum': '/SponsorLogos/Razum-logo.png',
  'Bubadu': '/SponsorLogos/Bubadu-logo-white.png',
};
const logoFor = (s: (typeof sponsors)[number]) => whiteLogos[s.name] ?? s.logo;
---

<section class="home-sponsors" id="sponsors" aria-labelledby="home-sponsors-title">
  <div class="container hs-wrap">
    <h2 id="home-sponsors-title">Sponsors</h2>

    {main && (
      <div class="hs-main">
        <img src={logoFor(main)} alt={main.name} class="hs-main-logo" />
      </div>
    )}

    <div class="hs-grid">
      {rest.map((s) => (
        <div class="hs-tile">
          <img src={logoFor(s)} alt={s.name} class="hs-logo" />
        </div>
      ))}
    </div>

    <p class="hs-link-row">
      Want to become a sponsor? <a href="/sponsors" class="hs-link">Get in touch →</a>
    </p>
  </div>
</section>

<style>
.home-sponsors {
  background: #12233b;
  color: #eef3f6;
  padding: 4.2rem 0 4.8rem;
}

.hs-wrap { width: min(1120px, 92%); text-align: center; }

.home-sponsors h2 {
  margin: 0 0 2.6rem;
  color: #ffffff;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1;
  letter-spacing: -0.02em;
  font-weight: 600;
}

.hs-main {
  display: flex;
  justify-content: center;
  margin-bottom: 2.8rem;
}

.hs-main-logo {
  height: clamp(4.5rem, 8vw, 7rem);
  width: auto;
  object-fit: contain;
}

.hs-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 1.5rem 2.5rem;
}

/* Every logo gets an identical box; the logo is contained within it (capped by
   both height and width). Equal footprints make the wall read as even
   regardless of each logo's proportions. */
.hs-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  width: clamp(150px, 20vw, 190px);
  height: 110px;
}

.hs-logo {
  max-height: 60px;
  max-width: 82%;
  width: auto;
  height: auto;
  object-fit: contain;
}

@media (max-width: 620px) {
  .hs-grid { gap: 1rem; }
  /* Two even columns; an odd last logo stays centered via justify-content. */
  .hs-tile { width: 45%; height: 116px; }
  .hs-logo { max-height: 58px; max-width: 84%; }
}

.hs-link-row {
  margin: 3rem 0 0;
  color: #aeb9c6;
  font-size: 1.02rem;
}

.hs-link {
  color: #ff7a4d;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
}

.hs-link:hover {
  color: #ff4d10;
  text-decoration: underline;
}
</style>
