---
// Shared site footer.
---
<footer class="site-footer">
  <div class="footer-container content-container content-stack">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-title">Slovenia Games Conference</div>
        <div class="footer-description">
          The annual conference on game development, design, marketing, and business in Slovenia.
        </div>
        <div class="footer-sponsor">
          <div class="footer-eyebrow">Brought to you by</div>
          <img
            src="/assets/slovenia-games-association-logo.png"
            alt="Slovenia Games Association"
            class="footer-association-logo"
          />
        </div>
      </div>
      <div class="footer-venue">
        <div class="footer-eyebrow">Venue</div>
        <div class="footer-venue-address">
          Faculty of Computer and Information Science<br />Večna pot 113<br />1000 Ljubljana
        </div>
      </div>
      <div class="footer-link-group">
        <div class="footer-link-heading">Links</div>
        <a class="footer-link" href="/speakers">Speakers</a>
        <a class="footer-link" href="/#agenda">Program</a>
        <a class="footer-link" href="/getting-here">Venue</a>
        <a class="footer-link" href="/#tickets">Tickets</a>
        <a class="footer-link" href="/indies">Indies</a>
      </div>
      <div class="footer-link-group">
        <div class="footer-link-heading">Follow us</div>
        <a class="footer-link" href="https://www.facebook.com/sloveniagames" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a class="footer-link" href="https://www.meetup.com/slovenia-games/" target="_blank" rel="noopener noreferrer">Meetup</a>
        <a class="footer-link" href="https://www.instagram.com/sloveniagames/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a class="footer-link" href="https://www.linkedin.com/company/slovenia-games-association/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="footer-link" href="https://www.youtube.com/@sloveniagames" target="_blank" rel="noopener noreferrer">YouTube</a>
      </div>
    </div>
    <div class="footer-bottom">
      <div>© 2027 Slovenia Games Association. All rights reserved.</div>
      <div class="footer-legal-links"><a href="/terms">Terms</a><a href="/privacy">Privacy</a></div>
    </div>
  </div>
</footer>
