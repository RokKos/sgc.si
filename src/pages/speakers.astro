---
import Layout from '../layouts/Layout.astro';
import SectionScrollNav from '../components/SectionScrollNav.vue';
import Footer from '../components/Footer.astro';
import { speakers, placeholderCount } from '../data/speakers';
import { NAV_HOME_BASE } from '../data/site';

const placeholders = Array.from({ length: placeholderCount });
---

<Layout title="Speakers - Slovenia Games Conference 2027">
  <SectionScrollNav client:load theme="light" base={NAV_HOME_BASE} />

  <main class="speakers-page">
    <section class="speakers-hero">
      <div class="container speakers-hero-inner">
        <p class="eyebrow">Slovenia Games Conference 2027</p>
        <h1>Speakers</h1>
        <p>
          Our speaker lineup is being finalized. Check back soon for the full list of game developers, designers, and industry leaders.
        </p>
      </div>
    </section>

    <section class="speakers-grid-section" aria-label="Speaker announcements">
      <div class="container speakers-grid-wrap">
        <div class="speakers-grid">
          {speakers.map((speaker) => (
            <a href={`/speakers/${speaker.slug}`} class="speaker-card">
              <div class="speaker-img-wrap">
                <img src={speaker.image} alt={speaker.name} class="speaker-img" />
              </div>
              <div class="speaker-info">
                <p class="speaker-name">{speaker.name}</p>
                <p class="speaker-role">{speaker.role}</p>
                <p class="speaker-company">{speaker.company}</p>
                <p class="speaker-bio">{speaker.bioShort}</p>
              </div>
            </a>
          ))}
          {placeholders.map(() => (
            <div class="speaker-card is-placeholder" aria-hidden="true">
              <div class="speaker-img-wrap placeholder-img">
                <span class="placeholder-emoji">🎙️</span>
              </div>
              <div class="speaker-info">
                <p class="speaker-name placeholder-text">Coming soon</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
.speakers-page { background: #f7f6f4; min-height: 100vh; }
.speakers-hero { padding: 7.2rem 0 2.2rem; }
.speakers-hero-inner { width: min(1120px, 94%); }
.eyebrow { margin: 0; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.78rem; font-weight: 700; color: #6a7278; }
.speakers-hero h1 { margin: 0.45rem 0 0; font-size: clamp(2.3rem, 6vw, 4.5rem); line-height: 0.94; letter-spacing: -0.03em; color: #1f2429; font-family: "Space Grotesk", "Segoe UI", sans-serif; }
.speakers-hero p { margin: 0.95rem 0 0; max-width: 55ch; color: #343b41; font-size: clamp(1rem, 1.25vw, 1.14rem); line-height: 1.55; }
.speakers-grid-section { padding: 0 0 4.6rem; }
.speakers-grid-wrap { width: min(1120px, 94%); }

.speakers-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  grid-auto-rows: 1fr;
  gap: 1.5rem;
}

.speaker-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 14px;
  overflow: hidden;
  border: none;
  text-decoration: none;
  color: inherit;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  box-shadow: 0 2px 12px rgba(0,0,0,0.08), 0 1px 3px rgba(0,0,0,0.06);
}

.speaker-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(0,0,0,0.14), 0 2px 8px rgba(0,0,0,0.08);
}

.speaker-img-wrap {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: #e8e6e1;
}

.speaker-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.speaker-info {
  padding: 1rem 1.1rem 1.2rem;
  text-align: center;
}

.speaker-name {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 600;
  color: #202328;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
}

.speaker-role {
  margin: 0.2rem 0 0;
  font-size: 0.88rem;
  color: #555b66;
}

.speaker-company {
  margin: 0.15rem 0 0;
  font-size: 0.82rem;
  color: #ff6f2c;
  font-weight: 500;
}

.speaker-bio {
  margin: 0.6rem 0 0;
  font-size: 0.85rem;
  line-height: 1.45;
  color: #555b66;
}

/* Empty placeholder cards — hint that more speakers are coming */
.speaker-card.is-placeholder {
  cursor: default;
  box-shadow: none;
  border: 2px dashed #d8d6db;
  background: rgba(255, 255, 255, 0.45);
  align-items: center;
  justify-content: center;
  gap: 1rem;
  padding: 1.5rem;
}

.speaker-card.is-placeholder:hover {
  transform: none;
  box-shadow: none;
}

.placeholder-img {
  aspect-ratio: auto;
  width: auto;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.placeholder-emoji {
  font-size: 3.6rem;
  opacity: 0.35;
  filter: grayscale(1);
}

.speaker-card.is-placeholder .speaker-info {
  padding: 0;
}

.placeholder-text {
  color: #9aa0a8;
  font-weight: 500;
}

@media (max-width: 1100px) {
  .speakers-grid { grid-template-columns: repeat(4, 1fr); }
}

@media (max-width: 820px) {
  .speakers-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
}

@media (max-width: 520px) {
  .speakers-grid { grid-template-columns: repeat(2, 1fr); }
}
</style>
