---
import Layout from '../layouts/Layout.astro';
import SectionScrollNav from '../components/SectionScrollNav.vue';
import Footer from '../components/Footer.astro';
import { speakers } from '../data/speakers';
import { NAV_HOME_BASE } from '../data/site';

const toParagraphs = (text?: string) =>
  text ? text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];
---

<Layout title="Meet the Speakers - Slovenia Games Conference 2027">
  <SectionScrollNav client:load base={NAV_HOME_BASE} />

  <main class="speakers-page">
    <section class="speakers-hero">
      <div class="container speakers-hero-inner">
        <p class="eyebrow">Slovenia Games Conference 2027</p>
        <h1>Meet the Speakers</h1>
        <p>
          Get to know the speakers joining us at Slovenia Games Conference 2027. Find out more
          about their experience, what they work on, and what they'll be talking about at the
          conference. More speakers will be announced soon!
        </p>
      </div>
    </section>

    <section class="speakers-list" aria-label="Speakers">
      <div class="container speakers-list-wrap">
        {speakers.map((speaker) => (
          <article class="speaker-card" id={speaker.slug}>
            <div class="speaker-photo">
              <img src={speaker.image} alt={speaker.name} loading="lazy" />
            </div>
            <div class="speaker-content">
              <h2 class="speaker-name">{speaker.name}</h2>
              <p class="speaker-role">{speaker.role}</p>
              <p class="speaker-company">{speaker.company}</p>
              {toParagraphs(speaker.bio).map((para) => (
                <p class="speaker-bio">{para}</p>
              ))}

              {speaker.talkTitle && (
                <div class="speaker-talk">
                  <p class="speaker-talk-label">Talk</p>
                  <h3 class="speaker-talk-title">{speaker.talkTitle}</h3>
                  {toParagraphs(speaker.talkDescription).map((para) => (
                    <p class="speaker-talk-desc">{para}</p>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
.speakers-page { background: #0d1620; }

/* Hero — the city photo reads as a clear image band across the top. */
.speakers-hero {
  position: relative;
  padding: 8.5rem 0 3.6rem;
  overflow: hidden;
  isolation: isolate;
}
/* Brighten the baked-dark photo so the city is clearly visible like the design. */
.speakers-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  background: url('/coming-soon-bg.jpg') center / cover no-repeat;
  filter: brightness(1.42) saturate(1.08);
}
/* Light legibility wash that only deepens to navy at the very bottom edge. */
.speakers-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(
    180deg,
    rgba(9, 15, 23, 0.26) 0%,
    rgba(9, 15, 23, 0.34) 52%,
    rgba(13, 22, 32, 0.78) 82%,
    #0d1620 100%
  );
}
.speakers-hero-inner { position: relative; z-index: 1; width: min(1120px, 94%); }
.eyebrow { margin: 0; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.78rem; font-weight: 700; color: rgba(255,255,255,0.6); }
.speakers-hero h1 { margin: 0.45rem 0 0; font-size: clamp(2.6rem, 7vw, 5rem); line-height: 0.92; letter-spacing: -0.03em; color: #ffffff; font-family: "Funnel Sans", "Segoe UI", sans-serif; }
.speakers-hero p { margin: 0.95rem 0 0; max-width: 60ch; color: rgba(255,255,255,0.82); font-size: clamp(1rem, 1.25vw, 1.14rem); line-height: 1.55; }

.speakers-list { padding: clamp(2.4rem, 5vw, 3.6rem) 0 4.6rem; background: #0d1620; }
.speakers-list-wrap { width: min(1120px, 94%); display: flex; flex-direction: column; gap: clamp(1.5rem, 3vw, 2.4rem); }

/* Each speaker in a navy card panel, photo on the left. */
.speaker-card {
  display: grid;
  grid-template-columns: 340px 1fr;
  gap: clamp(1.8rem, 4vw, 3.4rem);
  align-items: start;
  background: #16283d;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: clamp(1.8rem, 3vw, 2.6rem);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  scroll-margin-top: 110px;
}

.speaker-photo { position: relative; align-self: start; }

.speaker-photo img {
  position: relative;
  z-index: 1;
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  display: block;
}

/* Solid orange square offset behind the photo, peeking out left and bottom. */
.speaker-photo::after {
  content: "";
  position: absolute;
  z-index: 0;
  left: -9px;
  bottom: -20px;
  width: 100%;
  height: 100%;
  background: #e8432a;
}

.speaker-name {
  margin: 0;
  font-size: clamp(1.7rem, 3.2vw, 2.4rem);
  line-height: 1.02;
  letter-spacing: -0.02em;
  color: #ffffff;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
  font-weight: 700;
}

.speaker-role {
  margin: 0.5rem 0 0;
  color: rgba(255, 255, 255, 0.62);
  font-weight: 700;
  font-size: 1.02rem;
}

.speaker-company {
  margin: 0.15rem 0 0;
  color: #e8564a;
  font-weight: 700;
  font-size: 1.02rem;
}

.speaker-bio {
  margin: 1rem 0 0;
  color: rgba(255, 255, 255, 0.78);
  font-size: 1.02rem;
  line-height: 1.6;
}

.speaker-talk {
  margin-top: 2rem;
}

.speaker-talk-label {
  margin: 0;
  letter-spacing: 0.01em;
  font-size: 1.02rem;
  font-weight: 700;
  color: #e8564a;
}

.speaker-talk-title {
  margin: 0.4rem 0 0;
  font-size: clamp(1.3rem, 2.4vw, 1.7rem);
  line-height: 1.15;
  color: #ffffff;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
  font-weight: 700;
}

.speaker-talk-desc {
  margin: 0.8rem 0 0;
  color: rgba(255, 255, 255, 0.76);
  font-size: 1rem;
  line-height: 1.6;
}

@media (max-width: 760px) {
  .speaker-card { grid-template-columns: 1fr; gap: 1.6rem; }
  .speaker-photo { max-width: 320px; }
}

@media (max-width: 640px) {
  .speakers-hero { padding-top: 12rem; }
}
</style>
