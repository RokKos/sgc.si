---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { speakers } from '../data/speakers';

const toParagraphs = (text?: string) =>
  text ? text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];
---

<Layout title="Speakers – Slovenia Games Conference 2027" description="Meet the speakers joining us at Slovenia Games Conference 2027 – their experience, their work, and what they'll be talking about.">
  <!-- PAGE HERO -->
  <header id="top" class="page-hero">
    <img src="/assets/conference-hero.jpg" alt="" class="hero-image" />
    <div class="hero-overlay"></div>
    <SiteNav current="speakers" />
    <div class="content-container page-hero-content">
      <div class="page-hero-eyebrow">Slovenia Games Conference 2027</div>
      <h1 class="page-hero-title">Meet the Speakers</h1>
      <p class="page-hero-lead">Get to know the speakers joining us at Slovenia Games Conference 2027. Find out more about their experience, what they work on, and what they'll be talking about at the conference. More speakers will be announced soon!</p>
    </div>
  </header>

  <main>
    <section class="dark-section">
      <div class="content-container speaker-profile-list">
        {speakers.map((s) => (
          <article class="speaker-profile" id={s.slug}>
            <div class="speaker-photo-frame">
              {s.image ? (
                <img class="speaker-photo" src={s.image} alt={s.name} loading="lazy" />
              ) : (
                <div class="speaker-photo" role="img" aria-label={`Portrait placeholder for ${s.name}`}></div>
              )}
            </div>
            <div class="card card-navy">
              <div class="card-body">
                <div>
                  <h2 class="card-title venue-name">{s.name}</h2>
                  <div class="speaker-role">{s.role}</div>
                  <div class="card-label">{s.company}</div>
                </div>
                {toParagraphs(s.bio).map((p) => (
                  <p class="card-text">{p}</p>
                ))}
                {s.talkTitle && (
                  <div class="card-section">
                    <div class="card-label">{s.sessionType ?? 'Talk'}</div>
                    <h3 class="card-subtitle indie-item-title">{s.talkTitle}</h3>
                    {toParagraphs(s.talkDescription).map((p) => (
                      <p class="card-text">{p}</p>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="newsletter" class="newsletter-section">
      <div class="newsletter-container content-container">
        <div class="newsletter-copy">
          <h2 class="section-heading">More Speakers to Be Announced</h2>
          <p class="newsletter-description">Sign up to hear about new speakers, ticket news and event updates, straight to your inbox.</p>
        </div>
        <form class="newsletter-form" action="https://forms.gle/Pu1PB6qJTeaPp1kM7" method="get" target="_blank" rel="noopener noreferrer">
          <label for="nl-email" class="form-label">Email address</label>
          <div class="newsletter-form-actions">
            <input id="nl-email" type="email" placeholder="you@example.com" class="email-field" />
            <button type="submit" class="btn newsletter-submit">Subscribe</button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
