---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { sponsors, type SponsorTier } from '../data/sponsors';

const arrowSvg = `<svg width="18" height="18" viewBox="0 0 24 22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align: middle; margin-left: 0.4rem;"><path d="M5 12h14"></path><path d="M13 5l7 7-7 7"></path></svg>`;

const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const toParagraphs = (text?: string) =>
  text ? text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];

// The cards sit on dark navy/black panels, so use the light logo variants that
// read on a dark background (keyed by sponsor name; falls back to the data logo).
const lightLogos: Record<string, string> = {
  Guardiaris: '/assets/guardiaris-logo.png',
  'UL FRI — Faculty of Computer and Information Science': '/assets/fri-logo.png',
  Triternion: '/assets/triternion-logo.png',
  Outfit7: '/assets/outfit7-logo.png',
  Razum: '/assets/razum-logo.png',
  Bubadu: '/assets/bubadu-logo.png',
};
const displayLogo = (s: { name: string; logo: string }) => lightLogos[s.name] ?? s.logo;

// A tier-label shown as the card-label (only where it adds meaning).
const cardLabel = (tier: SponsorTier) =>
  tier === 'General' ? 'Main Sponsor' : tier === 'Venue' ? 'Venue Sponsor' : undefined;

// Sections, in display order. The top section carries the General + Venue sponsors.
const sectionDefs: { id: string; heading: string; tiers: SponsorTier[] }[] = [
  { id: 'general', heading: 'General', tiers: ['General', 'Venue'] },
  { id: 'platinum', heading: 'Platinum', tiers: ['Platinum'] },
  { id: 'gold', heading: 'Gold', tiers: ['Gold'] },
  { id: 'silver', heading: 'Silver', tiers: ['Silver'] },
  { id: 'bronze', heading: 'Bronze', tiers: ['Bronze'] },
];

const sections = sectionDefs
  .map((def) => ({ ...def, items: sponsors.filter((s) => def.tiers.includes(s.tier)) }))
  .filter((def) => def.items.length > 0);
---

<Layout title="Sponsors – Slovenia Games Conference 2027" description="The partners and sponsors making Slovenia Games Conference 2027 possible.">
  <!-- PAGE HERO -->
  <header id="top" class="page-hero">
    <img src="/assets/conference-hero.jpg" alt="" class="hero-image" />
    <div class="hero-overlay"></div>
    <SiteNav current="sponsors" />
    <div class="content-container page-hero-content">
      <div class="page-hero-eyebrow">Slovenia Games Conference 2027</div>
      <h1 class="page-hero-title">Sponsors</h1>
      <p class="page-hero-lead">The Slovenia Games Conference is made possible by our partners and sponsors. Thank you to everyone supporting the game development community in Slovenia.</p>
      <a class="btn hero-cta" href="#become-a-sponsor">Become a sponsor</a>
    </div>
  </header>

  <main>
    {sections.map((section, i) => {
      const gray = i % 2 === 1;
      const cardVariant = gray ? 'card-black' : 'card-navy';
      return (
        <section class={`dark-section${gray ? ' section-gray' : ''}`} id={section.id}>
          <div class="content-container content-stack">
            <h2 class="section-heading">{section.heading}</h2>
            <div class="card-grid">
              {section.items.map((s) => (
                <article class={`card ${cardVariant}`} id={slugify(s.name)}>
                  <div class="card-body">
                    <div class="card-logo"><img src={displayLogo(s)} alt={s.name} loading="lazy" /></div>
                    <h3 class="card-title venue-name">{s.name}</h3>
                    {cardLabel(s.tier) && <div class="card-label">{cardLabel(s.tier)}</div>}
                    <div class="card-text">
                      {toParagraphs(s.description).map((p) => (<p>{p}</p>))}
                    </div>
                    {s.url && (
                      <div class="card-actions"><a class="btn" href={s.url} target="_blank" rel="noopener noreferrer">Visit website<Fragment set:html={arrowSvg} /></a></div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    })}

    <section id="become-a-sponsor" class="newsletter-section">
      <div class="newsletter-container content-container">
        <div class="newsletter-copy">
          <h2 class="section-heading">Become a Sponsor</h2>
          <p class="newsletter-description">Put your brand in front of Slovenia's game developers, students and studios. Get in touch and we'll walk you through the sponsorship options for Slovenia Games Conference 2027.</p>
        </div>
        <div class="sponsor-cta-actions">
          <a class="btn newsletter-submit" href="mailto:info@sloveniagames.com?subject=Sponsoring%20SGC%202027"><span>Get in touch</span><Fragment set:html={arrowSvg} /></a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
