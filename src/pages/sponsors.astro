---
import Layout from '../layouts/Layout.astro';
import SectionScrollNav from '../components/SectionScrollNav.vue';
import Footer from '../components/Footer.astro';
import { sponsors, tierOrder } from '../data/sponsors';
import { NAV_HOME_BASE } from '../data/site';

const groupedTiers = tierOrder
  .map((tier) => ({ tier, items: sponsors.filter((s) => s.tier === tier) }));

const venueSponsors = sponsors.filter((s) => s.tier === 'Venue');
---

<Layout title="Sponsors - Slovenia Games Conference 2027">
  <SectionScrollNav client:load base={NAV_HOME_BASE} />

  <main class="sponsors-page">
    <section class="sponsors-hero">
      <div class="container sponsors-hero-inner">
        <p class="eyebrow">Slovenia Games Conference 2027</p>
        <h1>Sponsors</h1>
        <p>
          The Slovenia Games Conference is made possible by our partners and sponsors.
          Thank you to everyone supporting the game development community in Slovenia.
        </p>
      </div>
    </section>

    <section class="sponsors-list-section" aria-label="Our sponsors">
      <div class="container sponsors-wrap">
        {groupedTiers.map((group) => (
          <>
            <div class="tier-block">
              <h2 class="tier-title">{group.tier}</h2>
              {group.items.length === 0 && (
                <div class="tier-empty">
                  <p>Sponsor slots available — interested in becoming a {group.tier} sponsor?</p>
                </div>
              )}
              <div class="tier-sponsors">
                {group.items.map((sponsor) => {
                  const hasLink = sponsor.url && sponsor.url !== '#';
                  const CardTag = hasLink ? 'a' : 'article';
                  const linkProps = hasLink
                    ? { href: sponsor.url, target: '_blank', rel: 'noopener noreferrer' }
                    : {};
                  return (
                    <CardTag class={`sponsor-card tier-${group.tier.toLowerCase()}${hasLink ? ' is-link' : ''}`} {...linkProps}>
                      {group.tier === 'General' && <span class="main-badge">Main Sponsor</span>}
                      <div class="sponsor-logo-wrap">
                        <img src={sponsor.logo} alt={sponsor.name} class="sponsor-logo" />
                      </div>
                      <div class="sponsor-body">
                        <h3 class="sponsor-name">{sponsor.name}</h3>
                        {(sponsor.description
                          ? sponsor.description.split(/\n\s*\n/)
                          : ['Description coming soon.']
                        ).map((para, i) => (
                          <p class={`sponsor-desc${group.tier === 'General' && i === 0 ? ' is-highlight' : ''}`}>{para}</p>
                        ))}
                        {hasLink && <span class="sponsor-link">Visit website →</span>}
                      </div>
                    </CardTag>
                  );
                })}
              </div>
            </div>

            {group.tier === 'General' && venueSponsors.map((sponsor) => {
              const hasLink = sponsor.url && sponsor.url !== '#';
              const CardTag = hasLink ? 'a' : 'article';
              const linkProps = hasLink
                ? { href: sponsor.url, target: '_blank', rel: 'noopener noreferrer' }
                : {};
              return (
                <div class="venue-section" aria-label="Venue sponsor">
                  <CardTag class={`venue-card${hasLink ? ' is-link' : ''}`} {...linkProps}>
                    <span class="venue-badge">Venue Sponsor</span>
                    <div class="venue-logo-wrap">
                      <img src={sponsor.logo} alt={sponsor.name} class="venue-logo" />
                    </div>
                    <div class="venue-body">
                      <h2 class="venue-name">{sponsor.name}</h2>
                      <p class="venue-note">Proud host of Slovenia Games Conference 2027, providing the venue for the event.</p>
                      <p class="venue-desc">{sponsor.description || 'Description coming soon.'}</p>
                      {hasLink && <span class="sponsor-link">Visit website →</span>}
                    </div>
                  </CardTag>
                </div>
              );
            })}
          </>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
.sponsors-page {
  position: relative;
  min-height: 100vh;
  background-color: #0f1419;
  background-image:
    radial-gradient(circle at 50% 0%, rgba(255, 79, 18, 0.16), transparent 55%),
    linear-gradient(180deg, rgba(10, 12, 15, 0.62), rgba(10, 12, 15, 0.88)),
    url('/coming-soon-bg.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-attachment: fixed;
}
.sponsors-hero { padding: 8.5rem 0 2.2rem; }
.sponsors-hero-inner { width: min(1120px, 94%); }
.eyebrow { margin: 0; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.78rem; font-weight: 700; color: rgba(255,255,255,0.55); }
.sponsors-hero h1 { margin: 0.45rem 0 0; font-size: clamp(2.3rem, 6vw, 4.5rem); line-height: 0.94; letter-spacing: -0.03em; color: #ffffff; font-family: "Funnel Sans", "Segoe UI", sans-serif; }
.sponsors-hero p { margin: 0.95rem 0 0; max-width: 60ch; color: rgba(255,255,255,0.78); font-size: clamp(1rem, 1.25vw, 1.14rem); line-height: 1.55; }

.sponsors-list-section { padding: 1rem 0 4.6rem; }
.sponsors-wrap { width: min(1120px, 94%); }

/* Venue sponsor — special highlighted section */
.venue-section { margin-top: 3rem; }

.venue-card {
  position: relative;
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 2.4rem;
  align-items: center;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 122, 60, 0.35);
  border-radius: 20px;
  padding: 2.6rem 2.6rem 2.8rem;
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.35);
  color: inherit;
  text-decoration: none;
}

.venue-card.is-link {
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.venue-card.is-link:hover {
  transform: translateY(-4px);
  box-shadow: 0 24px 56px rgba(0, 0, 0, 0.45);
}

.venue-card.is-link:hover .sponsor-link { text-decoration: underline; }

.venue-badge {
  position: absolute;
  top: -0.9rem;
  left: 2.6rem;
  background: #c4502f;
  color: #fff;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
  font-weight: 700;
  font-size: 0.74rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 0.42rem 0.95rem;
  border-radius: 999px;
  box-shadow: 0 4px 12px rgba(196, 80, 47, 0.28);
}

.venue-logo-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 140px;
  background: #ffffff;
  border-radius: 14px;
  padding: 1.6rem;
}

.venue-logo { max-width: 100%; max-height: 140px; width: auto; height: auto; object-fit: contain; }

.venue-name {
  margin: 0.3rem 0 0;
  font-size: clamp(1.4rem, 2.6vw, 1.85rem);
  color: #ffffff;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
  font-weight: 700;
  line-height: 1.1;
}

.venue-note { margin: 0.7rem 0 0; color: #ff8a5c; font-weight: 600; font-size: 1.04rem; line-height: 1.5; }
.venue-desc { margin: 0.6rem 0 0; color: rgba(255,255,255,0.72); font-size: 1.02rem; line-height: 1.6; }

.tier-block { margin-top: 3rem; }
.tier-block:first-child { margin-top: 1rem; }

.tier-title {
  margin: 0 0 1.4rem;
  font-size: clamp(1.1rem, 2.2vw, 1.5rem);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-weight: 700;
  color: #ffffff;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
  padding-bottom: 0.7rem;
  border-bottom: 1px solid rgba(255,255,255,0.18);
}

.tier-sponsors { display: grid; gap: 1.5rem; }

.tier-empty {
  border: 2px dashed rgba(255,255,255,0.2);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.03);
  padding: 1.6rem 2rem;
  text-align: center;
}

.tier-empty p { margin: 0; color: rgba(255,255,255,0.55); font-size: 1rem; }

.sponsor-card {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 2.4rem;
  align-items: center;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 2.6rem;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
  color: inherit;
  text-decoration: none;
}

.sponsor-card.is-link {
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.sponsor-card.is-link:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 48px rgba(0, 0, 0, 0.4);
}

.sponsor-card.is-link:hover .sponsor-link {
  text-decoration: underline;
}

.sponsor-logo-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 90px;
  background: #ffffff;
  border-radius: 12px;
  padding: 1.2rem;
}

.sponsor-logo { max-width: 100%; max-height: 90px; width: auto; height: auto; object-fit: contain; }

/* All sponsor cards share the same 300px logo column (set on .sponsor-card) so
   logos and text columns line up across every tier and the venue card. */
.sponsor-logo-wrap { min-height: 130px; padding: 1.6rem; }

/* General tier (main sponsor) — larger logo. */
.tier-general { position: relative; }
.tier-general .sponsor-logo-wrap { min-height: 150px; }
.tier-general .sponsor-logo { max-height: 150px; }

.main-badge {
  position: absolute;
  top: -0.9rem;
  left: 2.6rem;
  background: #ff4d10;
  color: #fff;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
  font-weight: 700;
  font-size: 0.74rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 0.42rem 0.95rem;
  border-radius: 999px;
  box-shadow: 0 4px 14px rgba(255, 77, 16, 0.4);
}

/* Gold tier — slightly smaller logo */
.tier-gold .sponsor-logo { max-height: 70px; max-width: 78%; }

.sponsor-name {
  margin: 0;
  font-size: clamp(1.4rem, 2.6vw, 1.85rem);
  line-height: 1.1;
  color: #ffffff;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
  font-weight: 700;
}

.sponsor-desc { margin: 0.6rem 0 0; color: rgba(255,255,255,0.72); font-size: 1.02rem; line-height: 1.6; }

.sponsor-desc.is-highlight { color: #ff8a5c; font-weight: 600; }

.sponsor-link {
  display: inline-block;
  margin-top: 1rem;
  color: #ff8a5c;
  font-weight: 700;
  text-decoration: none;
  font-size: 0.98rem;
}

.sponsor-link:hover { text-decoration: underline; }

@media (max-width: 640px) {
  /* The mobile header wraps onto two rows, so it's taller — push the hero
     down to leave clear space beneath it. */
  .sponsors-hero { padding-top: 12rem; }

  .sponsor-card { grid-template-columns: 1fr; gap: 1.2rem; text-align: center; padding: 1.6rem; }
  .sponsor-logo-wrap { min-height: unset; }
  .sponsor-link { margin-top: 0.8rem; }

  .main-badge { left: 50%; transform: translateX(-50%); }

  .venue-card { grid-template-columns: 1fr; gap: 1.4rem; text-align: center; padding: 2.2rem 1.6rem 1.8rem; }
  .venue-badge { left: 50%; transform: translateX(-50%); }
  .venue-logo-wrap { min-height: unset; }
}
</style>
