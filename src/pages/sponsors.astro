---
import Layout from '../layouts/Layout.astro';
import SectionScrollNav from '../components/SectionScrollNav.vue';
import Footer from '../components/Footer.astro';
import { sponsors, tierOrder } from '../data/sponsors';
import { NAV_HOME_BASE } from '../data/site';

// Main sponsor (General) first, then the venue sponsor beside it, then the rest.
const generalItems = sponsors.filter((s) => s.tier === 'General');
const venueItems = sponsors.filter((s) => s.tier === 'Venue');

const groupedTiers = tierOrder
  .map((tier) => {
    // Show the venue sponsor alongside the main sponsor under "General".
    const items =
      tier === 'General'
        ? [...generalItems, ...venueItems]
        : sponsors.filter((s) => s.tier === tier);
    return { tier, items };
  })
  .filter((group) => group.items.length > 0);

// This section is on dark backgrounds, so prefer white/light logo variants.
const whiteLogos: Record<string, string> = {
  'Guardiaris': '/SponsorLogos/guardiarisWhiteLogo.png',
  'UL FRI — Faculty of Computer and Information Science': '/SponsorLogos/UL_FRI_logoHOR-RGB_bela.png',
  'Triternion': '/SponsorLogos/triternion-logo-white.png',
  'Outfit7': '/SponsorLogos/Outfit7-Logo.png',
  'Razum': '/SponsorLogos/Razum-logo.png',
  'Bubadu': '/SponsorLogos/Bubadu-logo-white.png',
};
const logoFor = (s: (typeof sponsors)[number]) => whiteLogos[s.name] ?? s.logo;

const tierLabel = (tier: string, sponsorTier: string) => {
  if (sponsorTier === 'General') return 'Main Sponsor';
  if (sponsorTier === 'Venue') return 'Venue Sponsor';
  return `${sponsorTier} Sponsor`;
};
const tierHeading = (tier: string) => (tier === 'General' ? 'General' : tier);
---

<Layout title="Sponsors - Slovenia Games Conference 2027">
  <SectionScrollNav client:load base={NAV_HOME_BASE} />

  <main class="sponsors-page">
    <section class="sponsors-hero">
      <div class="container sponsors-hero-inner">
        <p class="eyebrow">Slovenia Games Conference 2027</p>
        <h1>Sponsors</h1>
        <p>
          The Slovenia Games Conference is made possible by our partners and sponsors.
          Thank you to everyone supporting the game development community in Slovenia.
        </p>
        <a class="hero-cta" href="mailto:info@sgc.si?subject=Sponsoring%20Slovenia%20Games%20Conference%202027">Become a sponsor</a>
      </div>
    </section>

    {groupedTiers.map((group, i) => (
      <section class={`tier-section ${i % 2 === 0 ? 'is-navy' : 'is-dark'}`} aria-label={`${group.tier} sponsors`}>
        <div class="container">
          <h2 class="tier-title">{tierHeading(group.tier)}</h2>
          <div class="tier-grid">
            {group.items.map((sponsor) => {
              const hasLink = sponsor.url && sponsor.url !== '#';
              const CardTag = hasLink ? 'a' : 'article';
              const linkProps = hasLink
                ? { href: sponsor.url, target: '_blank', rel: 'noopener noreferrer' }
                : {};
              return (
                <CardTag class={`sponsor-card${hasLink ? ' is-link' : ''}`} {...linkProps}>
                  <div class="sponsor-logo-wrap">
                    <img src={logoFor(sponsor)} alt={sponsor.name} class="sponsor-logo" />
                  </div>
                  <h3 class="sponsor-name">{sponsor.name}</h3>
                  <p class="sponsor-tier-label">{tierLabel(group.tier, sponsor.tier)}</p>
                  {(sponsor.description
                    ? sponsor.description.split(/\n\s*\n/)
                    : ['Description coming soon.']
                  ).map((para) => (
                    <p class="sponsor-desc">{para}</p>
                  ))}
                  {hasLink && <span class="sponsor-link">Visit website →</span>}
                </CardTag>
              );
            })}
          </div>
        </div>
      </section>
    ))}

    <section class="become-sponsor" aria-labelledby="become-sponsor-title">
      <div class="container become-inner">
        <div class="become-copy">
          <h2 id="become-sponsor-title">Become a sponsor</h2>
          <p>
            Want to reach Slovenia's game developers, studios and students? Partner with
            Slovenia Games Conference 2027 and support the local games community.
          </p>
        </div>
        <a class="become-btn" href="mailto:info@sgc.si?subject=Sponsoring%20Slovenia%20Games%20Conference%202027">Get in touch →</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
.sponsors-page { background: #0d1620; }

/* Hero over the city photo. */
.sponsors-hero {
  padding: 9rem 0 3.4rem;
  background-image:
    linear-gradient(180deg, rgba(10, 12, 15, 0.5), rgba(13, 22, 32, 0.92)),
    url('/coming-soon-bg.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
.sponsors-hero-inner { width: min(1120px, 94%); }
.eyebrow { margin: 0; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.78rem; font-weight: 700; color: rgba(255,255,255,0.6); }
.sponsors-hero h1 { margin: 0.45rem 0 0; font-size: clamp(2.6rem, 7vw, 5rem); line-height: 0.92; letter-spacing: -0.03em; color: #ffffff; font-family: "Funnel Sans", "Segoe UI", sans-serif; }
.sponsors-hero p { margin: 0.95rem 0 0; max-width: 60ch; color: rgba(255,255,255,0.82); font-size: clamp(1rem, 1.25vw, 1.14rem); line-height: 1.55; }

.hero-cta {
  display: inline-flex;
  align-items: center;
  margin-top: 1.5rem;
  padding: 0.85rem 1.7rem;
  background: #ff4d10;
  color: #fff;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
}
.hero-cta:hover { background: #fff; color: #ff4d10; box-shadow: inset 0 0 0 2px #ff4d10; transform: translateY(-1px); }

/* Tier sections alternate navy / near-black. */
.tier-section { padding: clamp(2.6rem, 5vw, 4rem) 0; }
.tier-section .container { width: min(1120px, 94%); }
.tier-section.is-navy { background: #12233b; }
.tier-section.is-dark { background: #0d1620; }

.tier-title {
  margin: 0 0 1.8rem;
  font-size: clamp(1.8rem, 3.6vw, 2.8rem);
  line-height: 1;
  letter-spacing: -0.02em;
  font-weight: 700;
  color: #ffffff;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
}

.tier-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.6rem;
  align-items: start;
}

.sponsor-card {
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: clamp(1.6rem, 2.4vw, 2.2rem);
  color: inherit;
  text-decoration: none;
}

.sponsor-card.is-link { transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease; }
.sponsor-card.is-link:hover {
  transform: translateY(-4px);
  border-color: rgba(255, 122, 60, 0.4);
  box-shadow: 0 20px 48px rgba(0, 0, 0, 0.4);
}

.sponsor-logo-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-height: 72px;
  margin-bottom: 1.3rem;
}

.sponsor-logo { max-width: 72%; max-height: 72px; width: auto; height: auto; object-fit: contain; object-position: left center; }

.sponsor-name {
  margin: 0;
  font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  line-height: 1.08;
  color: #ffffff;
  font-family: "Funnel Sans", "Segoe UI", sans-serif;
  font-weight: 700;
}

.sponsor-tier-label {
  margin: 0.4rem 0 0;
  color: #ff6a3c;
  font-weight: 700;
  font-size: 1rem;
}

.sponsor-desc { margin: 0.8rem 0 0; color: rgba(255,255,255,0.74); font-size: 1rem; line-height: 1.6; }

.sponsor-link {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin-top: 1.4rem;
  padding: 0.72rem 1.4rem;
  background: #ff4d10;
  color: #fff;
  font-weight: 700;
  font-size: 0.96rem;
  text-decoration: none;
  transition: background 0.16s ease;
}
.sponsor-card.is-link:hover .sponsor-link { background: #e03d00; }

/* Become a sponsor — closing call to action. */
.become-sponsor { padding: clamp(2.6rem, 5vw, 4rem) 0 5rem; background: #0d1620; }

.become-inner {
  width: min(1120px, 94%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  flex-wrap: wrap;
  background: #c4502f;
  padding: clamp(1.8rem, 4vw, 2.8rem);
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.35);
}

.become-copy { max-width: 60ch; }
.become-copy h2 { margin: 0; font-size: clamp(1.7rem, 3.2vw, 2.6rem); line-height: 1; letter-spacing: -0.02em; color: #ffffff; font-family: "Funnel Sans", "Segoe UI", sans-serif; font-weight: 700; }
.become-copy p { margin: 0.7rem 0 0; color: rgba(255, 255, 255, 0.92); font-size: 1.05rem; line-height: 1.5; }

.become-btn {
  flex: none;
  display: inline-flex;
  align-items: center;
  padding: 0.9rem 1.8rem;
  background: #ffffff;
  color: #c4502f;
  font-weight: 800;
  text-decoration: none;
  transition: background 0.16s ease, color 0.16s ease, transform 0.16s ease;
}
.become-btn:hover { background: #1f1b19; color: #ffffff; transform: translateY(-1px); }

@media (max-width: 760px) {
  .tier-grid { grid-template-columns: 1fr; }
}

@media (max-width: 640px) {
  .sponsors-hero { padding-top: 12rem; }
}
</style>
