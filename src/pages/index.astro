---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.vue';
import SectionScrollNav from '../components/SectionScrollNav.vue';
import NoiseStageSection from '../components/NoiseStageSection.astro';
import EventHighlightsSection from '../components/EventHighlightsSection.astro';
import SpeakersShowcaseSection from '../components/SpeakersShowcaseSection.astro';
import VenueCarouselSection from '../components/VenueCarouselSection.astro';
import PreviousYearsVideoSection from '../components/PreviousYearsVideoSection.vue';
import SponsorsSection from '../components/SponsorsSection.astro';
import FaqSection from '../components/FaqSection.astro';
import NewsletterSection from '../components/NewsletterSection.astro';
import ConferencePartnersSection from '../components/ConferencePartnersSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Slovenia Games Conference 2027">
  <SectionScrollNav client:load />
  <main>
    <HeroSection client:load />
    <NoiseStageSection />
    <EventHighlightsSection />
    <SpeakersShowcaseSection />
    <VenueCarouselSection />
    <PreviousYearsVideoSection client:load />
    <SponsorsSection />
    <FaqSection />
    <NewsletterSection />
    <ConferencePartnersSection />
  </main>
  <Footer />
</Layout>
