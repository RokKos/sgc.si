---
import Layout from '../layouts/Layout.astro';
import SpeakersShowcaseSection from '../components/SpeakersShowcaseSection.astro';
---

<Layout title="Slovenia Games Conference 2027">
  <main class="coming-soon-page">
    <section class="hero">
      <div class="hero-overlay"></div>

      <img
        src="/sga-logo.png"
        alt="Slovenia Games Association"
        class="association-logo"
      />

      <div class="top-sponsor-logos">
        <img src="/SponsorLogos/guardiarisWhiteLogo.png" alt="Guardiaris" />
        <img
          src="/SponsorLogos/UL_FRI_logoHOR-RGB_bela.png"
          alt="UL FRI — Faculty of Computer and Information Science"
        />
      </div>

      <div class="hero-content">
        <img
          src="/sgc-logo.png"
          alt="Slovenia Games Conference"
          class="sgc-logo"
        />

        <p class="coming-soon-text">20.02.2027</p>
        <p class="date-text">FRI (Faculty of Computer Science and Informatics)</p>
        <p class="location-text">Ljubljana, Slovenia</p>

        <div class="hero-sponsor-logos">
          <img src="/SponsorLogos/guardiarisWhiteLogo.png" alt="Guardiaris" />
          <img
            src="/SponsorLogos/UL_FRI_logoHOR-RGB_bela.png"
            alt="UL FRI — Faculty of Computer and Information Science"
          />
        </div>
      </div>
    </section>

    <SpeakersShowcaseSection />
  </main>
</Layout>

<style>
  .coming-soon-page {
    min-height: 100vh;
    background: #0f1419;
    color: white;
  }

  .hero {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    text-align: center;
    overflow: hidden;

    background-image: url('/coming-soon-bg.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.78)),
      radial-gradient(circle at center, rgba(255, 79, 18, 0.22), transparent 55%);
    z-index: 1;
  }

  .association-logo {
    position: fixed;
    top: 2rem;
    left: 2rem;
    z-index: 10;
    width: min(20vw, 180px);
    height: auto;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  .top-sponsor-logos {
    position: fixed;
    top: 2rem;
    right: 2rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    pointer-events: none;
    user-select: none;
  }

  .top-sponsor-logos img {
    height: clamp(1.8rem, 3vw, 2.8rem);
    width: auto;
    object-fit: contain;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 2rem;
    width: min(90vw, 1000px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .sgc-logo {
    margin: 10rem 0 0;
    width: min(65vw, 600px);
    height: auto;
    display: block;
  }

  .coming-soon-text {
    margin: 5rem 0 0.6rem;
    font-size: clamp(1.2rem, 3vw, 2rem);
    font-weight: 100;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: rgba(255, 111, 44, 0.95);
  }

  .date-text {
    margin: -0.5rem 0 0;
    font-size: clamp(1.1rem, 2vw, 1.1rem);
    font-weight: 100;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: rgba(255, 255, 255, 0.75);
  }

  .location-text {
    margin: 0.4rem 0 0;
    font-size: clamp(1rem, 1.8vw, 1.1rem);
    font-weight: 100;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: rgba(255, 255, 255, 0.75);
  }

  .hero-sponsor-logos {
    margin: 3rem 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    flex-wrap: wrap;
    transform: translateX(clamp(1.5rem, 5vw, 4rem));
  }

  .hero-sponsor-logos img {
    height: clamp(2.4rem, 4.5vw, 3.6rem);
    width: auto;
    object-fit: contain;
  }

  /* Guardiaris is the main sponsor — show it larger */
  .hero-sponsor-logos img:first-child {
    height: clamp(3.6rem, 6.5vw, 5.4rem);
  }

  @media (max-width: 600px) {
    .association-logo {
      top: 1.25rem;
      left: 1.25rem;
      width: min(42vw, 180px);
    }

    .top-sponsor-logos {
      top: 1.35rem;
      right: 1.25rem;
      gap: 0.75rem;
    }

    .top-sponsor-logos img {
      height: 1.5rem;
    }

    .sgc-logo {
      width: min(92vw, 520px);
    }

    .coming-soon-text {
      letter-spacing: 0.16em;
    }

    .date-text,
    .location-text {
      letter-spacing: 0.16em;
    }
  }
</style>
