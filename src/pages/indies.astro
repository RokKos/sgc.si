---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { indies } from '../data/indies';

const registerUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSfEXcg5rVaIoENJwr-kdw7fjCBxa_j8pXiTyDIJsSvVyDmoww/viewform';
const arrowSvg = `<svg width="18" height="18" viewBox="0 0 24 22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align: middle; margin-left: 0.4rem;"><path d="M5 12h14"></path><path d="M13 5l7 7-7 7"></path></svg>`;

const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<Layout title="Indies – Slovenia Games Conference 2027" description="Meet the indie developers and studios showcasing their games at Slovenia Games Conference 2027.">
  <!-- PAGE HERO -->
  <header id="top" class="page-hero">
    <img src="/assets/conference-hero.jpg" alt="" class="hero-image" />
    <div class="hero-overlay"></div>
    <SiteNav current="indies" />
    <div class="content-container page-hero-content">
      <div class="page-hero-eyebrow">Slovenia Games Conference 2027</div>
      <h1 class="page-hero-title">Meet the Indies</h1>
      <p class="page-hero-lead">Play new games from independent developers and meet the people who made them. Building something yourself? Bring it to SGC 2027 and show it to the community.</p>
      <a class="btn hero-cta" href="#register">Register your game</a>
    </div>
  </header>

  <main>
    <!-- GAMES -->
    <section class="light-section">
      <div class="content-container content-stack">
        <h2 class="section-heading">Games at SGC27</h2>
        <div class="card-grid">
          {indies.map((indie) => (
            <article class="card card-light" id={slugify(indie.game)}>
              {indie.logo ? (
                <img class="card-media" src={indie.logo} alt={`${indie.game} key art`} loading="lazy" />
              ) : (
                <div class="card-media card-media-placeholder" role="img" aria-label={`${indie.game} key art`}>{indie.game}</div>
              )}
              <div class="card-body">
                <div class="card-label">{[indie.studio, indie.country, indie.year ?? '2027'].join(' · ')}</div>
                <h3 class="card-title venue-name">{indie.game}</h3>
                {(indie.description ? indie.description.split(/\n\s*\n/) : ['Description coming soon.']).map((p) => (
                  <p class="card-text">{p}</p>
                ))}
                {(indie.trailer || indie.link) && (
                  <div class="card-actions">
                    {indie.trailer && (
                      <a class="btn" href={indie.trailer} target="_blank" rel="noopener noreferrer">Trailer<Fragment set:html={arrowSvg} /></a>
                    )}
                    {indie.link && (
                      <a class="btn btn-outline" href={indie.link} target="_blank" rel="noopener noreferrer">Learn more<Fragment set:html={arrowSvg} /></a>
                    )}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- REGISTER -->
    <section id="register" class="indie-section">
      <div class="content-container content-stack">
        <h2 class="section-heading">Are you an indie developer?</h2>
        <div class="indie-grid">
          <div class="media-stack">
            <h3 class="indie-item-title">Showcase Your Game</h3>
            <div>Are you an indie developer or a game studio? Bring your game to SGC 2027 and connect with fellow developers and the wider game development community.</div>
          </div>
          <div class="media-stack">
            <h3 class="indie-item-title">Who Can Apply</h3>
            <div>Independent developers and studios with playable games, from early prototypes to released titles.</div>
          </div>
          <div class="media-stack">
            <h3 class="indie-item-title">Registration</h3>
            <div>Register your game before 20 January 2027. Our team will review your submission and contact you with confirmation and ticket instructions.</div>
          </div>
        </div>
        <div>
          <a class="btn" href={registerUrl} target="_blank" rel="noopener noreferrer">Register now<Fragment set:html={arrowSvg} /></a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
