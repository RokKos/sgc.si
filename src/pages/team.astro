---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { team } from '../data/team';

const arrowSvg = `<svg width="18" height="18" viewBox="0 0 24 22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align: middle; margin-left: 0.4rem;"><path d="M5 12h14"></path><path d="M13 5l7 7-7 7"></path></svg>`;

const hasPhoto = (p?: string) => !!p && !p.endsWith('placeholder.svg');
---

<Layout title="Team – Slovenia Games Conference 2027" description="Meet the people behind Slovenia Games Conference 2027 – the team that makes the conference happen.">
  <!-- PAGE HERO -->
  <header id="top" class="page-hero">
    <img src="/assets/conference-hero.jpg" alt="" class="hero-image" />
    <div class="hero-overlay"></div>
    <SiteNav current="team" />
    <div class="content-container page-hero-content">
      <div class="page-hero-eyebrow">Slovenia Games Conference 2027</div>
      <h1 class="page-hero-title">Meet the Team</h1>
      <p class="page-hero-lead">Slovenia Games Conference is organised by a group of volunteers who love games. Say hello to the people who make it happen.</p>
    </div>
  </header>

  <main>
    <section class="dark-section team-section">
      <div class="content-container">
        <div class="team-grid">
          {team.map((member) => (
            <div class="team-card">
              <div class="team-photo-frame">
                {hasPhoto(member.photo) ? (
                  <img class="team-photo" src={member.photo} alt={member.name} loading="lazy" />
                ) : (
                  <div class="team-photo" role="img" aria-label={`Photo placeholder for ${member.name}`}></div>
                )}
              </div>
              <div>
                <div class="speaker-name">{member.name}</div>
                {member.role && <div class="speaker-role">{member.role}</div>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="volunteer-section">
      <div class="volunteer-container content-container">
        <div class="volunteer-copy">
          <h2 class="section-heading">Become a Volunteer</h2>
          <p class="volunteer-description">Want to help make Slovenia Games Conference happen? Join our volunteer crew, meet people from the Slovenian games community, and get a behind-the-scenes look at the event.</p>
        </div>
        <a class="btn volunteer-button" href="mailto:info@sloveniagames.com?subject=Volunteering%20at%20SGC%202027"><span>Volunteer with us</span><Fragment set:html={arrowSvg} /></a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
