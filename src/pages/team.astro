---
import Layout from '../layouts/Layout.astro';
import SectionScrollNav from '../components/SectionScrollNav.vue';
import Footer from '../components/Footer.astro';
import { team } from '../data/team';
import { NAV_HOME_BASE } from '../data/site';
---

<Layout title="The Team - Slovenia Games Conference 2027">
  <SectionScrollNav client:load base={NAV_HOME_BASE} />

  <main class="team-page">
    <section class="team-hero">
      <div class="container team-hero-inner">
        <p class="eyebrow">Slovenia Games Association</p>
        <h1>The Team</h1>
        <p>
          Slovenia Games Conference 2027 is organised by volunteer members of the
          Slovenia Games Association. Meet the people making it happen.
        </p>
      </div>
    </section>

    <section class="team-list-section" aria-label="Organising team">
      <div class="container team-wrap">
        {team.length === 0 ? (
          <div class="team-empty">
            <p>The organising team will be announced here soon.</p>
          </div>
        ) : (
          <div class="team-grid">
            {team.map((member) => {
              const Tag = member.linkedin ? 'a' : 'div';
              const linkProps = member.linkedin
                ? { href: member.linkedin, target: '_blank', rel: 'noopener noreferrer' }
                : {};
              return (
                <Tag class={`team-card${member.linkedin ? ' is-link' : ''}`} {...linkProps}>
                  <div class="team-photo-wrap">
                    <img src={member.photo} alt={member.name} class="team-photo" />
                  </div>
                  <div class="team-body">
                    <p class="team-name">{member.name}</p>
                    <p class="team-role">{member.role}</p>
                    {member.bio && <p class="team-bio">{member.bio}</p>}
                    {member.linkedin && <span class="team-link">View profile →</span>}
                  </div>
                </Tag>
              );
            })}
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
.team-page {
  position: relative;
  min-height: 100vh;
  background-color: #0f1419;
  background-image:
    radial-gradient(circle at 50% 0%, rgba(255, 79, 18, 0.16), transparent 55%),
    linear-gradient(180deg, rgba(10, 12, 15, 0.62), rgba(10, 12, 15, 0.88)),
    url('/coming-soon-bg.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-attachment: fixed;
}

.team-hero { padding: 8.5rem 0 2.2rem; }
.team-hero-inner { width: min(1120px, 94%); }
.eyebrow { margin: 0; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.78rem; font-weight: 700; color: rgba(255,255,255,0.55); }
.team-hero h1 { margin: 0.45rem 0 0; font-size: clamp(2.3rem, 6vw, 4.5rem); line-height: 0.94; letter-spacing: -0.03em; color: #ffffff; }
.team-hero p { margin: 0.95rem 0 0; max-width: 60ch; color: rgba(255,255,255,0.78); font-size: clamp(1rem, 1.25vw, 1.14rem); line-height: 1.55; }

.team-list-section { padding: 1.4rem 0 4.6rem; }
.team-wrap { width: min(1120px, 94%); }

.team-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
  margin-top: 1rem;
}

.team-empty {
  margin-top: 1rem;
  border: 2px dashed rgba(255,255,255,0.2);
  background: rgba(255, 255, 255, 0.03);
  padding: 2.4rem 2rem;
  text-align: center;
}
.team-empty p { margin: 0; color: rgba(255,255,255,0.6); font-size: 1.05rem; }

.team-card {
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  overflow: hidden;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
  color: inherit;
  text-decoration: none;
}

.team-card.is-link {
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}
.team-card.is-link:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.36);
}

.team-photo-wrap {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: #e8e6e1;
}

.team-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.team-body { padding: 1.2rem 1.3rem 1.4rem; }

.team-name {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 700;
  color: #ffffff;
  font-family: "Funnel Display", "Funnel Sans", "Segoe UI", sans-serif;
}

.team-role {
  margin: 0.25rem 0 0;
  color: #ff8a5c;
  font-weight: 600;
  font-size: 0.98rem;
}

.team-bio {
  margin: 0.7rem 0 0;
  color: rgba(255,255,255,0.72);
  font-size: 0.98rem;
  line-height: 1.55;
}

.team-link {
  display: inline-block;
  margin-top: 0.9rem;
  color: #ff8a5c;
  font-weight: 700;
  font-size: 0.95rem;
}

@media (max-width: 860px) {
  .team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 640px) {
  .team-hero { padding-top: 12rem; }
  .team-grid { grid-template-columns: 1fr; }
}
</style>
